Algoritmo Ejercicio12
definir x, variableY, z como entero // no se puede nombrar una variable como "y" en PSeInt, por conflicto, por lo que la nombraré como "variableY"
x <- 10
variableY <- 5
z <- 2

si (x / z) = variableY entonces
	Escribir "Verdarero"
sino
	Escribir "Falso"
finsi
FinAlgoritmo