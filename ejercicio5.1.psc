//Ejercicio 5.1 de Mario Escudero Flores
Algoritmo Ejercicio51
	definir diaSemana como entero
	escribir "Dime un numero del dia de la semana (1-7)"
	leer diaSemana

	segun diaSemana hacer
		1:
			escribir "Lunes"
		2: 
			escribir "Martes"
		3: 
			escribir "Miercoles"
		4: 
			escribir "Jueves"
		5: 
			escribir "Viernes"
		6: 
			escribir "Sabado"
		7: 
			escribir "Domingo"
		de otro modo:
			escribir "El numero introducido no es válido"
	finsegun
FinAlgoritmo