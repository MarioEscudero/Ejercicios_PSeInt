//Ejercicio 9.1 de Mario Escudero Flores
Algoritmo Ejercicio91
	definir mes, dia como entero
	dimension fecha[2]
	escribir "Introduce el mes: "
	leer mes
	fecha[1] <- mes
	escribir "Introduce el día: "
	leer dia
	fecha[2] <- dia
	escribir "La fecha introducida es: ", fecha[2], "/", fecha[1]
FinAlgoritmo