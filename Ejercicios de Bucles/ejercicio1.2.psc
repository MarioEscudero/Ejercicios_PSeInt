Algoritmo Ejercicio12
definir suma, contador, numeros como entero
suma <- 0
contador <- 0
mientras suma < 100 hacer
	escribir "Introduce un número: "
	leer numeros
	suma <- suma + numeros
	contador <- contador + 1
finmientras
escribir "La suma de los números introducidos es: ", suma
escribir "El número de números introducidos es: ", contador
FinAlgoritmo