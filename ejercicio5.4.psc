//Ejercicio 5.4 de Mario Escudero Flores
Algoritmo Ejercicio54
	definir diaMes como entero
	escribir "Dime un numero del mes(1-12)"
	leer diaMes

	si diaMes=1 entonces
		escribir "Enero"
	sino si diaMes=2 entonces
			escribir "Febrero"
	sino si diaMes=3 entonces
			escribir "Marzo"
	sino si diaMes=4 entonces
			escribir "Abril"
	sino si diaMes=5 entonces
			escribir "Mayo"
	sino si diaMes=6 entonces
			escribir "Junio"
	sino si diaMes=7 entonces
			escribir "Julio"
	sino si diaMes=8 entonces
			escribir "Agosto"
	sino si diaMes=9 entonces
			escribir "Septiembre"
	sino si diaMes=10 entonces
			escribir "Octubre"
	sino si diaMes=11 entonces
			escribir "Noviembre"
	sino si diaMes=12 entonces
			escribir "Diciembre"
	sino
		escribir "El numero introducido no es válido"
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
	finsi
FinAlgoritmo
