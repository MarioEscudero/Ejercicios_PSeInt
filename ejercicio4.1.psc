//Ejercicio 4.1 de Mario Escudero Flores
Algoritmo Ejercicio41
	definir primerNumero, segundoNumero como Entero
	escribir "Dime un primer número"
	leer primerNumero
	escribir "Dime un segundo número"
	leer segundoNumero

	si primerNumero = segundoNumero entonces
		escribir "Los números son iguales"
	sino
		escribir "Los números son diferentes"
	finsi
FinAlgoritmo
