//Ejercicio 4.3 de Mario Escudero Flores
Algoritmo Ejercicio43
	definir variableNumero como Entero
	escribir "Dime un numero"
	leer variableNumero

	si variableNumero > 0 entonces
		escribir "Es positivo"
	sino si variableNumero < 0 entonces
			escribir "Es negativo"
	sino
			escribir "Es igual a cero"
	finsi
	finsi
FinAlgoritmo
