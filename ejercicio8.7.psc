//Ejercicio 8.7 de Mario Escudero Flores
Algoritmo Ejercicio87
	definir ancho, alto como entero
	escribir "Introduce el ancho del cuadrado: "
	leer ancho

	para fila <- 1 hasta ancho hacer
		para columna <- 1 hasta ancho hacer
			escribir sin saltar "* "
		finpara
		escribir ""
	finpara
FinAlgoritmo